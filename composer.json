{
    "name": "mevisoft/laravel-mcp",
    "description": "Rapidly build MCP servers for your Laravel applications.",
    "keywords": [
        "mcp",
        "laravel"
    ],
    "homepage": "https://github.com/laravel/mcp",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laravel/mcp/issues",
        "source": "https://github.com/laravel/mcp"
    },
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/container": "^v8.83.0",
        "illuminate/console": "^v8.83.0",
        "illuminate/contracts": "^v8.83.0",
        "illuminate/http": "^v8.83.0",
        "illuminate/routing": "^v8.83.0",
        "illuminate/support": "^v8.83.0",
        "illuminate/validation": "^v8.83.0"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Mcp\\": "src/",
            "Laravel\\Mcp\\Server\\": "src/Server/",
            "Illuminate\\": "polyfill/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravel\\Mcp\\Server\\McpServiceProvider"
            ],
            "aliases": {
                "Mcp": "Laravel\\Mcp\\Server\\Facades\\Mcp"
            }
        }
    },
    "scripts": {

    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
